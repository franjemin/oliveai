# Olive v1 Core — local scaffold
NODE_ENV=development
HOST=0.0.0.0
PORT=3000

DATABASE_URL=postgres://olive:olive@localhost:5432/olive
# Wave A baseline: force TLS to Postgres in shared/prod (local compose stays off)
DATABASE_SSL=false

# Wave A baseline: serve the API over TLS when certs are provided (prod terminator or these paths)
# TLS_CERT_PATH=/etc/olive/tls/tls.crt
# TLS_KEY_PATH=/etc/olive/tls/tls.key

# Canada-first residency (no schema fork; US/cross-border is config + notice later)
DATA_RESIDENCY_REGION=ca-central-1
OBJECT_STORE_REGION=ca-central-1

# AES-256-GCM key (32 bytes hex). Local scaffold only — rotate in real deploys.
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# MinIO (docker compose). Leave blank to use local filesystem object store.
S3_ENDPOINT=http://localhost:9000
S3_REGION=ca-central-1
S3_BUCKET=olive-audio
S3_ACCESS_KEY=olive
S3_SECRET_KEY=oliveolive
S3_FORCE_PATH_STYLE=true

# Retention
AUDIO_RETENTION_HOURS=24
NOTE_TRANSCRIPT_RETENTION_YEARS=10

# Feature flags (training / Aftercare / Claims Guard / OD write-back off)
FLAG_AFTERCARE=false
FLAG_CLAIMS_GUARD=false
FLAG_PHI_TRAINING_ALLOWED=false
FLAG_OD_WRITEBACK=false

# Demo auth (seed user). Change before any shared environment.
DEMO_EMAIL=od@demo.olive.local
DEMO_PASSWORD=demo
